@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center" style="padding: 80px 20px;">
    <h1 style="font-size: 3.2em; color: #6F4E37; font-weight: bold; margin-bottom: 20px;">
        Bienvenido a R&M BarberShop
    </h1>
    <p style="font-size: 1.4em; color: #3B2A20; max-width: 600px; margin: 0 auto 40px auto;">
        Tu estilo, tu momento. Agenda tu cita fácil y rápido y luce increíble.
    </p>
    <div style="display: flex; justify-content: center; gap: 15px; flex-wrap: wrap;">
        <a class="btn btn-primary" href="/Citas/Create" style="padding: 14px 35px; font-size: 1.1em; background-color: #6F4E37; border-color: #6F4E37;">
            Agendar cita
        </a>
        <a class="btn" href="/Servicios" style="padding: 14px 35px; font-size: 1.1em; background-color: #B89B7A; color: #fff; border: none;">
            Ver servicios
        </a>
    </div>
</div>
